[Unit]
Description=LuigiBot Web GUI (FastAPI + Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luigi-web
Group=luigi-web
WorkingDirectory=/opt/luigi-web
# Non-authentication settings may be changed by the Admin environment editor.
EnvironmentFile=/opt/luigi-web/luigi.env
# Authentication secrets override any stale values in the editable file.
# Keep this file root-owned, mode 0600, and outside ReadWritePaths.
EnvironmentFile=/etc/luigi-web/credentials.env
Environment=LUIGI_WEB_ENV_FILE=/opt/luigi-web/luigi.env
# Skip pip cache — ProtectHome=true hides ~/.cache/pip anyway.
Environment=PIP_NO_CACHE_DIR=1
# Silence pip's version-check chatter in the journal.
Environment=PIP_DISABLE_PIP_VERSION_CHECK=1

# Refresh Python dependencies on every start. Fast when nothing changed
# (pip just reports "already satisfied"). The leading `-` makes failure
# non-fatal so an offline / PyPI-down box can still boot the last known
# good code instead of leaving the service dead.
ExecStartPre=-/opt/luigi-web/.venv/bin/python -m pip install \
  --disable-pip-version-check \
  --no-cache-dir \
  -r /opt/luigi-web/requirements.txt

ExecStart=/opt/luigi-web/.venv/bin/uvicorn app:app \
  --host ${LUIGI_WEB_BIND} \
  --port ${LUIGI_WEB_PORT} \
  --workers 1 \
  --no-access-log

Restart=always
RestartSec=2s
# Give ExecStartPre time to run pip install on slow networks.
TimeoutStartSec=300

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/luigi-web /opt/luigi-web/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
