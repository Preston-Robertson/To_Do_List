# Public placeholders only. Never commit real values or personal identifiers.
# Copy to .env for local dev, or use a protected environment file in production.
LUIGI_WEB_PG_HOST=<postgres-host>
LUIGI_WEB_PG_PORT=5432
LUIGI_WEB_PG_DB=luigi_todo
LUIGI_WEB_PG_USER=luigi_web
LUIGI_WEB_PG_PASSWORD=<random-database-password>
LUIGI_WEB_UI_TOKEN=<long-random-ui-token>
LUIGI_WEB_FINANCE_TOKEN=<different-long-random-finance-token>
LUIGI_WEB_SECURE_COOKIES=1
LUIGI_WEB_BIND=0.0.0.0
LUIGI_WEB_PORT=8080

# Path to the env file the Admin > "Environment file" editor writes.
# Leave unset for local dev (defaults to <repo>/.env).
# Production example: LUIGI_WEB_ENV_FILE=/opt/luigi-web/luigi.env
LUIGI_WEB_ENV_FILE=

# --- Finance (app-owned, never exposed to the LLM) ---
LUIGI_WEB_FINANCE_DB=/opt/luigi-web/data/finance.db
LUIGI_WEB_FINANCE_BASE_CURRENCY=USD

# --- LLM chat (Home dashboard "Assistant" panel) ---
# GitHub Models was retired on July 30, 2026. To use a GitHub Copilot
# subscription, set PROVIDER=copilot. An interactive install can use an
# existing Copilot/GitHub CLI login; a headless service should put a
# fine-grained GitHub token for the subscribed account in API_KEY. The official
# Copilot SDK runs in empty mode with only LuigiBot's allow-listed task tools.
#
# OpenAI-compatible /chat/completions endpoints remain available by setting
# PROVIDER=openai, BASE_URL, API_KEY, and MODEL.
LUIGI_WEB_LLM_PROVIDER=disabled
LUIGI_WEB_LLM_BASE_URL=
LUIGI_WEB_LLM_API_KEY=
LUIGI_WEB_LLM_MODEL=
LUIGI_WEB_LLM_TIMEOUT=60
LUIGI_WEB_LLM_MAX_TOOL_ITERATIONS=5
LUIGI_WEB_COPILOT_HOME=/opt/luigi-web/data/copilot

# --- Game'N'Watch (Games/Shows tabs) ---
# Reads/writes the SAME Google Sheet the Game'N'Watch Discord bot uses:
#   Game'N'Watch repository documentation
#
# Setup:
#   1. Reuse the bot's Google service account (it already has Editor access to
#      the sheet), or paste it into the authenticated Admin page.
#   2. Put the Sheet ID here (the long id in the sheet URL:
#        https://docs.google.com/spreadsheets/d/<THIS_PART>/edit )
#   3. The service-account email must have Editor access to that sheet
#      (it already does if it's the bot's account).
#
# Leave LUIGI_WEB_GNW_SHEET_ID blank to hide the Games/Shows tabs entirely.
LUIGI_WEB_GNW_SHEET_ID=
# Leave LUIGI_WEB_GNW_CREDS_FILE BLANK to use the app-managed path
# (<repo>/gnw-credentials.json) that the Admin page can write to directly —
# recommended, since it needs no host-side file placement. Only set this if
# you want the key at a specific path the service can write to.
LUIGI_WEB_GNW_CREDS_FILE=
LUIGI_WEB_STEAM_API_KEY=
LUIGI_WEB_STEAM_ID=
LUIGI_WEB_YOUTUBE_API_KEY=
