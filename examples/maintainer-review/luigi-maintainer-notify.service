[Unit]
Description=Luigi maintenance notification outbox
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/luigi-web/maintainer-review/notify.env

[Service]
Type=oneshot
User=luigi-maintainer-notify
Group=luigi-maintainer-notify
EnvironmentFile=/etc/luigi-web/maintainer-review/notify.env
Environment=HOME=/var/lib/luigi-maintainer-notify
ReadWritePaths=/var/lib/luigi-maintainer-notify
InaccessiblePaths=/var/lib/luigi-maintainer
InaccessiblePaths=/var/lib/luigi-maintainer-preview /var/lib/luigi-maintainer-gateway
ExecStart=/opt/luigi-web/.venv/bin/python -m luigi_web.modules.feedback.review_worker --notify
TimeoutStartSec=2m
NoNewPrivileges=true
RestrictNamespaces=true
ProtectControlGroups=true
CapabilityBoundingSet=
