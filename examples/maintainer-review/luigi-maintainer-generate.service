[Unit]
Description=Luigi maintenance candidate generation (rootless sandbox)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/luigi-web/maintainer-review/generate.env

[Service]
Type=oneshot
User=luigi-maintainer
Group=luigi-maintainer
EnvironmentFile=/etc/luigi-web/maintainer-review/generate.env
Environment=HOME=/var/lib/luigi-maintainer
Environment=LUIGI_MAINTAINER_STATE_DIR=/var/lib/luigi-maintainer
Environment=XDG_CONFIG_HOME=/var/lib/luigi-maintainer/config
Environment=XDG_DATA_HOME=/var/lib/luigi-maintainer/share
Environment=XDG_RUNTIME_DIR=/run/luigi-maintainer
RuntimeDirectory=luigi-maintainer
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/luigi-maintainer
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 0 /var/lib/luigi-maintainer/controller.lock /opt/luigi-web/.venv/bin/python -m luigi_web.modules.feedback.review_worker --generate
TimeoutStartSec=6h
Delegate=yes
NoNewPrivileges=false
RestrictNamespaces=false
ProtectControlGroups=false
